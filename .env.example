# HavenlyAI Environment Configuration Example
# Copy this file to .env and configure your secrets

# Google Gemini AI Studio API Key (Gemini 2.0 / 1.5 Flash / Multimodal Live API)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Simulated Demo Mode (Set to false when using active API keys)
EXPO_PUBLIC_DEMO_MODE=false

# Custom Backend Proxy URL (Optional)
EXPO_PUBLIC_API_URL=https://api.havenly.ai/v1

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
