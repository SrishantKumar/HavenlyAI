  "cards": [
    {
      "dot": "emerald",
      "title": "Cache-Aside Read Pattern",
      "items": [
        "The application actively manages cache reads, misses, and population",
        "Only cache misses incur database disk I/O and query latency"
      ]
    },
    {
      "dot": "rose",
      "title": "Fallback to Source of Truth",
      "items": [
        "Cache miss immediately triggers indexed SQL query against PostgreSQL",
        "PostgreSQL returns authoritative row data with minimal connection pool overhead"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cache Population & Response",
      "items": [
        "API backfills Redis cache with explicit TTL to avoid stale memory",
        "Client receives response immediately with fresh JSON payload"
      ]
    }
